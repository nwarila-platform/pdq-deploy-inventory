!/ansible/applications/pdq_deploy/handlers/main.yml
!/ansible/applications/pdq_deploy/meta/main.yml
!/ansible/applications/pdq_deploy/tasks/absent_windows.yml
!/ansible/applications/pdq_deploy/tasks/clean_windows.yml
!/ansible/applications/pdq_deploy/tasks/main.yml
!/ansible/applications/pdq_deploy/tasks/present_windows.yml
!/ansible/applications/pdq_deploy/tasks/validate.yml
