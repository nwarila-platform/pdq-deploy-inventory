!/ansible/applications/pdq_inventory/README.md
!/ansible/applications/pdq_inventory/defaults/main.yml
# The stubs name their source scripts under scripts/; the materialized files/*.ps1 are build
# artifacts, deliberately NEVER allowlisted, so they cannot be committed.
!/ansible/applications/pdq_inventory/files/Get-InstalledSoftware.ps1.stub
!/ansible/applications/pdq_inventory/files/Set-PdqSetting.ps1.stub
!/ansible/applications/pdq_inventory/files/Set-PdqRegistration.ps1.stub
!/ansible/applications/pdq_inventory/files/Set-PdqVariable.ps1.stub
!/ansible/applications/pdq_inventory/files/Remove-PdqVariable.ps1.stub
!/ansible/applications/pdq_inventory/files/Set-PdqCollection.ps1.stub
!/ansible/applications/pdq_inventory/files/Remove-PdqCollection.ps1.stub
!/ansible/applications/pdq_inventory/files/collections/Chrome Below Pinned Version.xml
!/ansible/applications/pdq_inventory/handlers/main.yml
!/ansible/applications/pdq_inventory/meta/main.yml
!/ansible/applications/pdq_inventory/tasks/absent_windows.yml
!/ansible/applications/pdq_inventory/tasks/clean_windows.yml
!/ansible/applications/pdq_inventory/tasks/main.yml
!/ansible/applications/pdq_inventory/tasks/present_windows.yml
