        <PowerShellStep>
          <CustomCommandLine></CustomCommandLine>
          <Files>$(Repository)\~resources\Get-InstalledSoftware.ps1</Files>
          <Script>$PinnedVersion = '@(Igor-Pavlov_7-Zip)'
$VersionParts = $PinnedVersion.Split('.')
If ($VersionParts.Count -lt 2) {
  Write-Error -Message:('Verification failed: pinned version {0} does not contain both major and minor components.' -f $PinnedVersion) -ErrorAction:'Continue'
  Exit 3
}
$DisplayName = '7-Zip {0}.{1} (x64 edition)' -f $VersionParts[0], $VersionParts[1]
Try {
  $Result = &amp; ".\Get-InstalledSoftware.ps1" -DisplayName $DisplayName -Version $PinnedVersion | ConvertFrom-Json -ErrorAction:'Stop'
} Catch {
  Write-Error -Message:('Verification failed: {0}' -f $PSItem.Exception.Message) -ErrorAction:'Continue'
  Exit 3
}
If ($Null -eq $Result) {
  Write-Error -Message:'Verification failed: Get-InstalledSoftware.ps1 did not return a result.' -ErrorAction:'Continue'
  Exit 3
}
If ($Result.ambiguous) {
  Write-Error -Message:('Verification failed: {0}' -f $Result.msg) -ErrorAction:'Continue'
  Exit 2
}
If ($Result.count -ne 1) {
  Write-Error -Message:('Verification failed: the install did not produce the expected MSI registration named {1} (count {0}).' -f $Result.count, $DisplayName) -ErrorAction:'Continue'
  Exit 1
}
If ($Result.installed_version -ine $PinnedVersion) {
  Write-Error -Message:('Verification failed: 7-Zip installed version {0} does not match pinned version {1}.' -f $Result.installed_version, $PinnedVersion) -ErrorAction:'Continue'
  Exit 1
}
$ProductId = [String]$Result.entries[0].product_id
If ([String]::IsNullOrEmpty($ProductId) -or $ProductId -notmatch '^\{[0-9A-F]{8}(?:-[0-9A-F]{4}){3}-[0-9A-F]{12}\}$') {
  Write-Error -Message:('Verification failed: 7-Zip registration product_id {0} is not a brace GUID; the registration is not an MSI product.' -f $ProductId) -ErrorAction:'Continue'
  Exit 1
}
Exit 0</Script>
