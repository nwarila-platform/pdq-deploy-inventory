      <Steps type="list">
        <PowerShellStep>
          <CustomCommandLine></CustomCommandLine>
          <Files></Files>
          <Script>$Process = Start-Process `
  -FilePath:'msiexec.exe' `
  -ArgumentList:@(
    '/fa'
    '@(Google-LLC_Google-Chrome-ProductCode)'
    '/qn'
    '/norestart'
  ) `
  -PassThru `
