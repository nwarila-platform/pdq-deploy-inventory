@ECHO OFF
REM =========================================================================================== #
REM  Start the repository sync, which pulls the application repository down from S3.
REM
REM  Right-click this file and choose "Run as administrator": Task Scheduler refuses to start the
REM  sync from a session that is not elevated. The sync runs in the background as the scheduled
REM  task named below, the same one every deployment starts, and a start while it is already
REM  running is ignored.
REM
REM  The sync is DETERMINISTIC: afterwards the repository holds what the bucket holds and nothing
REM  else. It copies what is new or newer, and removes what the bucket does not carry -- including
REM  anything placed there by hand. Older versions stay available for a rollback in the bucket,
REM  rather than on whichever host happens to still have a copy.
REM
REM  Generated by the pdq_deploy role. Edits here are overwritten on the next deployment --
REM  change the role, not this file.
REM =========================================================================================== #
SCHTASKS /Run /TN "{{ __sync_task__ }}"
SET "SYNC_EXIT=%ERRORLEVEL%"
ECHO.
IF "%SYNC_EXIT%"=="0" (
    ECHO Task Scheduler accepted the start. While the sync runs, the "{{ __sync_task__ }}" task shows Running
    ECHO in Task Scheduler, and the sync writes its result to {{ __sync_log__ }}
    ECHO If the task shows Ready and that log has not changed, the sync could not start, as happens
    ECHO when the account it runs as cannot log on, for example when it is disabled.
    ECHO A start while a sync is already running is ignored, so once that sync has finished,
    ECHO run this again to pick up anything published since it began.
) ELSE (
    ECHO The sync did not start. Starting it needs administrator rights: close this window,
    ECHO right-click the file, and choose "Run as administrator".
)
PAUSE
EXIT /B %SYNC_EXIT%
