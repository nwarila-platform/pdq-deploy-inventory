<# :
@ECHO OFF
REM =========================================================================================== #
REM  Pull the application repository down from S3.
REM
REM  Right-click this file and choose "Run as administrator". The directory this fills grants
REM  write access to SYSTEM and Administrators only, so an ordinary session cannot fill it.
REM
REM  This file is BOTH a batch file and the PowerShell script it runs: the batch half below the
REM  marker hands the whole file to PowerShell, which reads the half above as a comment. What an
REM  administrator runs here is byte-for-byte what the deployment runs.
REM
REM  The sync is ADDITIVE: it copies what is new or newer and deletes nothing, which is what
REM  keeps older versions on disk for a rollback.
REM
REM  Generated by the pdq_deploy role. Edits here are overwritten on the next deployment --
REM  change the role, not this file.
REM =========================================================================================== #
NET SESSION >NUL 2>&1
IF ERRORLEVEL 1 (
    ECHO STOPPED: this script needs administrator rights.
    ECHO Close this window, right-click the file, and choose "Run as administrator".
    PAUSE
    EXIT /B 1
)
POWERSHELL -NoProfile -ExecutionPolicy Bypass -Command "& ([ScriptBlock]::Create((Get-Content -LiteralPath '%~f0' -Raw))) -Bucket '{{ pdq_deploy_running.repository.bucket }}' -Path '{{ __repository_dir__ }}' -Region '{{ pdq_deploy_running.repository.region }}'"
SET "SYNC_EXIT=%ERRORLEVEL%"
IF NOT "%SYNC_EXIT%"=="0" (
    ECHO.
    ECHO SYNC FAILED. The message above says why. The two usual causes are that this server
    ECHO is not allowed to read the bucket, or that the bucket name is wrong.
)
PAUSE
EXIT /B %SYNC_EXIT%
: #>
{{ lookup('ansible.builtin.file', role_path + '/files/Set-RepositoryContent.ps1') }}
