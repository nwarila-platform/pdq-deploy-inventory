@ECHO OFF
REM =========================================================================================== #
REM  Pull the application repository down from S3.
REM
REM  Right-click this file and choose "Run as administrator". The directory this fills grants
REM  write access to SYSTEM and Administrators only, so an ordinary session cannot fill it.
REM
REM  The sync is ADDITIVE: 'aws s3 sync' copies what is new or newer and deletes nothing, which
REM  is what keeps older versions on disk for a rollback. Do not add --delete.
REM
REM  Generated by the pdq_deploy role. Edits here are overwritten on the next deployment --
REM  change the role, not this file.
REM =========================================================================================== #
SETLOCAL

SET "BUCKET={{ pdq_deploy_running.repository.bucket }}"
SET "REGION={{ pdq_deploy_running.repository.region }}"
SET "TARGET={{ __repository_dir__ }}"
SET "AWSCLI=%ProgramFiles%\Amazon\AWSCLIV2\aws.exe"

ECHO Application repository sync
ECHO   from  s3://%BUCKET%/
ECHO   to    %TARGET%
ECHO.

REM  Nothing below can succeed unelevated, so say so plainly instead of failing on the first file.
NET SESSION >NUL 2>&1
IF ERRORLEVEL 1 (
    ECHO STOPPED: this script needs administrator rights.
    ECHO Close this window, right-click the file, and choose "Run as administrator".
    GOTO :FINISH
)

IF NOT EXIST "%AWSCLI%" (
    ECHO STOPPED: the AWS command line tool is not installed at
    ECHO   %AWSCLI%
    ECHO Install it on this server, then run this again.
    GOTO :FINISH
)

"%AWSCLI%" s3 sync "s3://%BUCKET%/" "%TARGET%" --region "%REGION%" --no-progress
IF ERRORLEVEL 1 (
    ECHO.
    ECHO SYNC FAILED. The message above says why. The two usual causes are that this server
    ECHO is not allowed to read the bucket, or that the bucket name is wrong.
    GOTO :FINISH
)

ECHO.
ECHO Sync complete. Anything listed above was added or updated; nothing was deleted.

:FINISH
ECHO.
PAUSE
ENDLOCAL
