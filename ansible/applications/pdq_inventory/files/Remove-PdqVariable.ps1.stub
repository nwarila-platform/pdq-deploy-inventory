# Build marker, not the script. scripts/materialize-role-scripts.sh copies the source named
# below to files/Remove-PdqVariable.ps1 before the role is linted or run; that copy is a
# build artifact the .gitignore deliberately never allowlists.
#
# The script is developed, reviewed and pair-tested once under scripts/, beside its
# Remove-PdqVariable.pester.ps1 spec. It is shared with pdq_deploy -- one custom-variable
# model answers on both products' command lines, so the same source serves each.
scripts/Remove-PdqVariable.ps1
