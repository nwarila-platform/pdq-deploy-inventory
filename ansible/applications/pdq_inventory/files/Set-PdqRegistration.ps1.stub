# Build marker, not the script. scripts/materialize-role-scripts.sh copies the source named
# below to files/Set-PdqRegistration.ps1 before the role is linted or run; that copy is a
# build artifact the .gitignore deliberately never allowlists.
#
# The script is developed, reviewed and pair-tested once under scripts/, beside its
# Set-PdqRegistration.pester.ps1 spec. It is shared with pdq_deploy because both products use the
# same registration schema, so the same source serves each.
scripts/Set-PdqRegistration.ps1
