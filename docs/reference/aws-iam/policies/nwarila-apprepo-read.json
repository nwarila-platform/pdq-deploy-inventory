{
  "Statement": [
    {
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::<account-id>-apprepo",
      "Sid": "ListTheApplicationRepository"
    },
    {
      "Action": "s3:GetObject",
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::<account-id>-apprepo/*",
      "Sid": "ReadApplicationRepositoryObjects"
    }
  ],
  "Version": "2012-10-17"
}
