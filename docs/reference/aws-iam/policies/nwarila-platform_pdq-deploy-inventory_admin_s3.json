{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPdqAppRepoPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<account-id>-apprepo",
      "Condition": {
        "StringEquals": { "aws:ResourceAccount": "<account-id>" },
        "StringLike": { "s3:prefix": [ "PDQ/*", "PDQ/" ] }
      }
    },
    {
      "Sid": "PublishPdqInstallersAndLicences",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::<account-id>-apprepo/PDQ/*/*.exe",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/pdq-deploy-license.lic",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/pdq-inventory-license.lic"
      ],
      "Condition": {
        "StringEquals": { "aws:ResourceAccount": "<account-id>" }
      }
    },
    {
      "Sid": "AbortAStalledMultipartUpload",
      "Effect": "Allow",
      "Action": "s3:AbortMultipartUpload",
      "Resource": "arn:aws:s3:::<account-id>-apprepo/PDQ/*",
      "Condition": {
        "StringEquals": { "aws:ResourceAccount": "<account-id>" }
      }
    }
  ]
}
