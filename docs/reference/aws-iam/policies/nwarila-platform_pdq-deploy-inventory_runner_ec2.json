{
  "Statement": [
    {
      "Action": [
        "ec2:DescribeSubnets",
        "ec2:DescribeImages",
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeInstanceCreditSpecifications",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeTags",
        "ec2:DescribeVpcs",
        "ec2:DescribeAvailabilityZones",
        "ec2:DescribeKeyPairs"
      ],
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "DescribeForPlanning"
    },
    {
      "Action": "ec2:RunInstances",
      "Condition": {
        "Null": {
          "aws:RequestTag/CommitSha": "false",
          "aws:RequestTag/Environment": "false",
          "aws:RequestTag/RunId": "false"
        },
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "Terraform",
          "aws:RequestTag/Repository": "nwarila-platform/pdq-deploy-inventory",
          "aws:RequestTag/RepositoryId": "1347369220"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:us-east-1:<account-id>:instance/*",
        "arn:aws:ec2:us-east-1:<account-id>:volume/*"
      ],
      "Sid": "RunInstancesTaggedCreations"
    },
    {
      "Action": "ec2:RunInstances",
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:us-east-1:<account-id>:network-interface/*",
      "Sid": "RunInstancesUntaggableEni"
    },
    {
      "Action": "ec2:RunInstances",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:us-east-1::image/*",
        "arn:aws:ec2:us-east-1:<account-id>:subnet/*",
        "arn:aws:ec2:us-east-1:<account-id>:security-group/*",
        "arn:aws:ec2:us-east-1:<account-id>:key-pair/*",
        "arn:aws:ec2:us-east-1:<account-id>:placement-group/*"
      ],
      "Sid": "RunInstancesReferencedResources"
    },
    {
      "Action": [
        "ec2:TerminateInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:ModifyInstanceAttribute"
      ],
      "Condition": {
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/Environment": "false",
          "ec2:ResourceTag/RunId": "false"
        },
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "Terraform",
          "ec2:ResourceTag/Repository": "nwarila-platform/pdq-deploy-inventory",
          "ec2:ResourceTag/RepositoryId": "1347369220"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:us-east-1:<account-id>:instance/*",
      "Sid": "ManageOwnedInstanceLifecycle"
    },
    {
      "Action": "ec2:CreateTags",
      "Condition": {
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/Environment": "false",
          "ec2:ResourceTag/RunId": "false"
        },
        "StringEquals": {
          "ec2:ResourceTag/ManagedBy": "Terraform",
          "ec2:ResourceTag/Repository": "nwarila-platform/pdq-deploy-inventory",
          "ec2:ResourceTag/RepositoryId": "1347369220"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ec2:us-east-1:<account-id>:instance/*",
        "arn:aws:ec2:us-east-1:<account-id>:volume/*"
      ],
      "Sid": "TagResourcesWeAlreadyOwn"
    }
  ],
  "Version": "2012-10-17"
}
