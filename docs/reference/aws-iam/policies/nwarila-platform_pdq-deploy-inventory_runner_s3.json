{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteOnlyTheStateFileAndItsLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::<account-id>-terraform/nwarila-platform/pdq-deploy-inventory/aws-poc.tfstate",
        "arn:aws:s3:::<account-id>-terraform/nwarila-platform/pdq-deploy-inventory/aws-poc.tfstate.tflock"
      ]
    },
    {
      "Sid": "ListOnlyThoseTwoKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<account-id>-terraform",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "nwarila-platform/pdq-deploy-inventory/aws-poc.tfstate",
            "nwarila-platform/pdq-deploy-inventory/aws-poc.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyThePDQLicences",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/pdq-deploy-license.lic",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/pdq-inventory-license.lic"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    },
    {
      "Sid": "ReadOnlyThePDQInstaller",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::<account-id>-apprepo/PDQ.com/PDQ Deploy/*/PDQ_Deploy_x86-x64.exe",
        "arn:aws:s3:::<account-id>-apprepo/PDQ.com/PDQ Inventory/*/PDQ_Inventory_x86-x64.exe"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    },
    {
      "Sid": "ReadOnlyTheServiceAccountSecret",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/svc-pdq-password.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    },
    {
      "Sid": "ReadOnlyTheNetworkAndDirectoryArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::<account-id>-apprepo/OpenVPN.net/OpenVPN Community/*/OpenVPN_Community_amd64.msi",
        "arn:aws:s3:::<account-id>-ansible/applications/openvpn/aws-ec2-test.ovpn",
        "arn:aws:s3:::<account-id>-apprepo/applications/domain_member/svc-domainjoin-password.txt"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    }
  ]
}
