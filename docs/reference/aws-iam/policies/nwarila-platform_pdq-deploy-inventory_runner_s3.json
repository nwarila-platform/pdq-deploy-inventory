{
  "Statement": [
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::<account-id>-terraform/nwarila-platform/pdq-deploy-inventory/aws-poc.tfstate",
        "arn:aws:s3:::<account-id>-terraform/nwarila-platform/pdq-deploy-inventory/aws-poc.tfstate.tflock"
      ],
      "Sid": "ReadWriteOnlyTheStateFileAndItsLock"
    },
    {
      "Action": "s3:ListBucket",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "nwarila-platform/pdq-deploy-inventory/aws-poc.tfstate",
            "nwarila-platform/pdq-deploy-inventory/aws-poc.tfstate.tflock"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::<account-id>-terraform",
      "Sid": "ListOnlyThoseTwoKeys"
    },
    {
      "Action": "s3:GetObject",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::<account-id>-apprepo/*",
      "Sid": "ReadAppRepoByExactPathOnlyNoListing"
    },
    {
      "Action": [
        "s3:GetObjectTagging",
        "s3:PutObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::<account-id>-apprepo/~resources/Get-InstalledSoftware.ps1",
        "arn:aws:s3:::<account-id>-apprepo/~resources/Start-Uninstaller.ps1"
      ],
      "Sid": "PublishTheTwoHelperScriptsPackagesRun"
    },
    {
      "Action": "s3:GetObject",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/pdq-deploy-license.lic",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/pdq-inventory-license.lic",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/pdq-deploy-license-key.lic",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/pdq-inventory-license-key.lic",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/pdq-deploy-license-email.txt",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/pdq-inventory-license-email.txt"
      ],
      "Sid": "ReadOnlyThePDQLicences"
    },
    {
      "Action": "s3:GetObject",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/svc-pdq-password.txt",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/svc-pdq-domain-password.txt",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/svc-pdq-ws-password.txt",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/svc-pdq-ms-password.txt",
        "arn:aws:s3:::<account-id>-ansible/applications/pdq/svc-pdq-dc-password.txt"
      ],
      "Sid": "ReadOnlyTheServiceAccountSecret"
    },
    {
      "Action": "s3:GetObject",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      },
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::<account-id>-ansible/host_roles/domain_member/svc-domainjoin-password.txt",
        "arn:aws:s3:::<account-id>-ansible/host_roles/remote_client/aws-ec2-test.ovpn"
      ],
      "Sid": "ReadOnlyTheDomainJoinAndOpenVpnCredentials"
    }
  ],
  "Version": "2012-10-17"
}
