{
  "Statement": [
    {
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:us-east-1:<account-id>:parameter/nwarila/ami/*",
      "Sid": "ReadTheImageCatalogParametersOnly"
    },
    {
      "Action": "ssm:DescribeInstanceInformation",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "DescribeSsmManagedInstances"
    },
    {
      "Action": "ssm:StartSession",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/RepositoryId": "1347369220"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:us-east-1:*:instance/*",
      "Sid": "SsmSessionOnlyToOurTaggedInstances"
    },
    {
      "Action": "ssm:StartSession",
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:us-east-1::document/AWS-StartSSHSession",
      "Sid": "SsmStartSshSessionDocument"
    },
    {
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:us-east-1:*:session/${aws:userid}-*",
      "Sid": "SsmSessionTeardownInRegion"
    },
    {
      "Action": "ssm:SendCommand",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/RepositoryId": "1347369220"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:ec2:us-east-1:*:instance/*",
      "Sid": "SendCommandOnlyToOurTaggedInstances"
    },
    {
      "Action": "ssm:SendCommand",
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:us-east-1::document/AWS-RunPowerShellScript",
      "Sid": "SendCommandOnlyWithThePowerShellDocument"
    },
    {
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      },
      "Effect": "Allow",
      "Resource": "*",
      "Sid": "ReadOwnCommandResults"
    }
  ],
  "Version": "2012-10-17"
}
