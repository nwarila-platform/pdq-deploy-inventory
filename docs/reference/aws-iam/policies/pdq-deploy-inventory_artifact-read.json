{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadPdqArtifacts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<account-id>-ansible/applications/pdq/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    },
    {
      "Sid": "ListPdqArtifactPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<account-id>-ansible",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        },
        "StringLike": {
          "s3:prefix": [
            "applications/pdq/*"
          ]
        }
      }
    }
  ]
}
