{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTheApplicationRepository",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::<account-id>-apprepo"
    },
    {
      "Sid": "ReadEveryApplicationRepositoryObject",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<account-id>-apprepo/*"
    }
  ]
}
