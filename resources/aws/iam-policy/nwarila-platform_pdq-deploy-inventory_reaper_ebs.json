{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeVolumes",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumeAttribute"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DetachOwnedVolumeAndInstance",
      "Effect": "Allow",
      "Action": "ec2:DetachVolume",
      "Resource": [
        "arn:aws:ec2:us-east-1:<account-id>:volume/*",
        "arn:aws:ec2:us-east-1:<account-id>:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Repository": "nwarila-platform/pdq-deploy-inventory",
          "ec2:ResourceTag/RepositoryId": "1347369220",
          "ec2:ResourceTag/ManagedBy": "Terraform"
        },
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/RunId": "false",
          "ec2:ResourceTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "DeleteOwnedVolume",
      "Effect": "Allow",
      "Action": "ec2:DeleteVolume",
      "Resource": "arn:aws:ec2:us-east-1:<account-id>:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Repository": "nwarila-platform/pdq-deploy-inventory",
          "ec2:ResourceTag/RepositoryId": "1347369220",
          "ec2:ResourceTag/ManagedBy": "Terraform"
        },
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/RunId": "false",
          "ec2:ResourceTag/Environment": "false"
        }
      }
    }
  ]
}
