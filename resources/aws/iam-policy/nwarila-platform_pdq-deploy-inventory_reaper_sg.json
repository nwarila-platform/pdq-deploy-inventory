{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeSecurityGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSecurityGroupRules"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RevokeRulesAndDeleteOwnedGroupsOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": "arn:aws:ec2:us-east-1:<account-id>:security-group/*",
      "Condition": {
        "StringEquals": {
          "ec2:ResourceTag/Repository": "nwarila-platform/pdq-deploy-inventory",
          "ec2:ResourceTag/RepositoryId": "1347369220",
          "ec2:ResourceTag/ManagedBy": "Terraform"
        },
        "Null": {
          "ec2:ResourceTag/CommitSha": "false",
          "ec2:ResourceTag/RunId": "false",
          "ec2:ResourceTag/Environment": "false"
        }
      }
    },
    {
      "Sid": "RevokeRuleObjectsInOwnedGroups",
      "Effect": "Allow",
      "Action": [
        "ec2:RevokeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress"
      ],
      "Resource": "arn:aws:ec2:us-east-1:<account-id>:security-group-rule/*"
    }
  ]
}
