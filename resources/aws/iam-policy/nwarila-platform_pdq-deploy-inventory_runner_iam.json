{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheOrgInstanceProfile",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": [
        "arn:aws:iam::<account-id>:instance-profile/nwarila-platform_instance-baseline_ec2",
        "arn:aws:iam::<account-id>:instance-profile/nwarila-platform_pdq-deploy-inventory_ec2"
      ]
    },
    {
      "Sid": "PassOnlyTheOrgEc2RoleAndOnlyToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::<account-id>:role/nwarila-platform_instance-baseline_ec2",
        "arn:aws:iam::<account-id>:role/nwarila-platform_pdq-deploy-inventory_ec2"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
