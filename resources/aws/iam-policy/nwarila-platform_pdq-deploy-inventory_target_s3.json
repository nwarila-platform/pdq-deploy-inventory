{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyTheFeatureOnDemandPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<account-id>-apprepo",
      "Condition": {
        "StringLike": { "s3:prefix": "fod/*" }
      }
    },
    {
      "Sid": "ReadTheFeatureOnDemandPayloads",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<account-id>-apprepo/fod/*"
    }
  ]
}
